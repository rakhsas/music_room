<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        The backend URL is configurable at runtime (Server Settings screen) so testers
        can point the app at any server - a fixed per-host allowlist would defeat that,
        so cleartext HTTP is allowed for all hosts. This app is not shipped to a public
        store, so this trade-off is acceptable for a test/defense build.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>