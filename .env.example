# The ONE env file for the whole repo (backend + web). Copy to .env (`make install` does it).
# Read by docker-compose (`make up`), by the backend on the host (`make dev`), and by the web
# app's next.config.ts (NEXT_PUBLIC_* keys only). A value containing "$" must be wrapped in
# single quotes, e.g. SECRET_KEY='abc$def', or docker-compose expands it.

########## Backend ##########

# Container names: correct inside Docker. `make dev` / `make backend` override these two with
# localhost:5433 / localhost:6379 for a backend running on your machine.
DATABASE_URL=postgresql://postgres:postgres123@db:5432/musicroom
REDIS_URL=redis://redis:6379/1

# Signs every JWT. Use a long random string.
SECRET_KEY=change-me

# Free key from https://devportal.jamendo.com - without it no music loads.
JAMENDO_CLIENT_ID=

# Base URL put in verification e-mails - must be reachable from the phone/browser that opens them
# (use your PC's LAN IP to open the links from a phone).
DEFAULT_API_URL=http://localhost:8000

# Gmail account + app password (https://myaccount.google.com/apppasswords) for verification /
# password-reset mails.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

NODE_ENV=development

########## Web ##########

# Address the BROWSER uses to reach the API. If you publish the API on another port
# (API_PORT=18000 make up), change it here too.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Google "Web" OAuth client ID (Google Cloud Console > Credentials > Create OAuth client ID >
# type "Web application"). NOT the Android client ID in App/app/google-services.json.
# Add http://localhost:3000 as an authorized JavaScript origin.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

########## Docker ports (optional) ##########
# API_PORT=8000
# WEB_PORT=3000
